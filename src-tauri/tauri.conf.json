{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroFlow",
  "version": "0.1.0",
  "identifier": "com.github.keekyslusus.zeroflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "ZeroFlow Settings",
        "width": 720,
        "height": 560,
        "decorations": true,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "music",
        "title": "ZeroFlow Music",
        "width": 480,
        "height": 520,
        "decorations": true,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "../static/icons/icon.png"
    ],
    "resources": [
      "../static/sounds/*"
    ]
  },
  "plugins": {}
}